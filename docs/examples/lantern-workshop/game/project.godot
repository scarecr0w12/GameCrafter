; Native Godot 4 tutorial fixture; no engine installation is bundled.
config_version=5

[application]
config/name="Lantern Workshop"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=960
window/size/viewport_height=640

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.067, 0.051, 0.11, 1)
